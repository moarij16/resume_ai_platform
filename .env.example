# Copy this file to .env and fill in the values.
# Commented-out keys are optional; uncomment only to override the default.

# --- Django ---
SECRET_KEY=
DEBUG=
# comma-separated, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=

# --- Database (defaults to local SQLite when unset) ---
# pgvector models need PostgreSQL with the `vector` extension
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# --- JWT auth ---
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7

# --- CORS (comma-separated origins, e.g. http://localhost:3000) ---
CORS_ALLOWED_ORIGINS=

# --- File storage (local media/ folder when unset) ---
# SUPABASE_S3_ENDPOINT=
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_BUCKET_NAME=user-resumes
# SUPABASE_S3_REGION=ap-south-1

# --- AI ---
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
